"==============================================================================
" built-in settings
"==============================================================================

" reload vimrc on save (disabled by default — slows down large configs)
" autocmd BufWritePost $MYVIMRC source $MYVIMRC

" disable vi compatibility mode
set nocompatible

set nu          " show line numbers
set cursorline  " highlight current line
set showmatch   " highlight matching brackets
set hlsearch    " highlight all search matches

set mouse=n     " enable mouse in normal mode

" use system clipboard for copy/paste
" check support with: :echo has('clipboard')
" see: https://vi.stackexchange.com/a/96
set clipboard=unnamed

" WSL clipboard support
if filereadable("/mnt/c/Windows/System32/clip.exe")
  let s:clip = '/mnt/c/Windows/System32/clip.exe'
  if executable(s:clip)
    augroup WSLYank
      autocmd!
      autocmd TextYankPost * if v:event.operator ==# 'y' | call system(s:clip, @0) | endif
    augroup END
  endif
endif

" indentation
set tabstop=4     " tab width
set shiftwidth=4  " auto-indent width
set autoindent    " inherit indentation from previous line

let mapleader=","

" re-yank selection after paste so the clipboard is not replaced
xnoremap p pgvy

" system clipboard mappings
vmap <Leader>c "+yy
nmap <Leader>c "+yy
nmap <Leader>v "+p

set smartcase   " case-sensitive when search pattern contains uppercase

set hidden      " allow switching buffers without saving

set splitright  " vertical split opens to the right
set splitbelow  " horizontal split opens below

set scrolloff=5 " keep 5 lines of context above/below cursor when scrolling

set wildmenu    " show completion menu in command mode

set backspace=indent,eol,start  " allow backspace across lines in insert mode

set belloff=all " disable all bells (Vim 8+)

set encoding=utf-8  " default to UTF-8 (important on some Ubuntu setups)

" persistent undo across sessions
set undofile
set undodir=~/.vim/undodir

set signcolumn=yes  " always show sign column to avoid layout shifts (gitgutter)

set incsearch   " incremental search
set ignorecase  " case-insensitive search
syntax on
filetype plugin indent on

" auto-save on leaving insert mode for common file types
au InsertLeave *.go,*.sh,*.php,*.rs write

"==============================================================================
" plugins (vim-plug)
" install: https://github.com/junegunn/vim-plug
"==============================================================================

call plug#begin('~/.vim/plugged')

" editing helpers
Plug 'tpope/vim-surround'
Plug 'tpope/vim-repeat'
Plug 'tpope/vim-abolish'
Plug 'tomtom/tcomment_vim'
Plug 'jiangmiao/auto-pairs'
Plug 'mg979/vim-visual-multi'
Plug 'junegunn/vim-easy-align'

" editorconfig support (built-in in Vim 9.0+; plugin needed for older versions)
Plug 'editorconfig/editorconfig-vim'

" highlight trailing whitespace
Plug 'ntpeters/vim-better-whitespace'

" file explorer with git status icons
Plug 'preservim/nerdtree'
Plug 'Xuyuanp/nerdtree-git-plugin'

" git integration
Plug 'tpope/vim-fugitive'
Plug 'airblade/vim-gitgutter'

" fuzzy finder — uses system fzf if installed, otherwise installs it
" :Rg requires ripgrep (rg) to be available on PATH
Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
Plug 'junegunn/fzf.vim'

" Go support — only loaded when `go` is available on PATH
if executable('go')
  Plug 'fatih/vim-go', { 'tag': '*' }
endif

" fast cursor movement
Plug 'easymotion/vim-easymotion'

" status bar
Plug 'vim-airline/vim-airline'

" Rust syntax and formatting
Plug 'rust-lang/rust.vim'

" color scheme
Plug 'XiaoXiaoSN/vim-sublime-monokai'

call plug#end()


"==============================================================================
" color scheme
"==============================================================================

colorscheme sublimemonokai


"==============================================================================
" editorconfig
"==============================================================================

" prevent editorconfig from conflicting with fugitive buffers
let g:EditorConfig_exclude_patterns = ['fugitive://.*']


"==============================================================================
" vim-go (only when `go` is on PATH)
"==============================================================================

if executable('go')
  let g:go_fmt_command             = 'goimports'
  let g:go_autodetect_gopath       = 1
  let g:go_list_type               = 'quickfix'
  let g:go_highlight_types         = 1
  let g:go_highlight_fields        = 1
  let g:go_highlight_functions     = 1
  let g:go_highlight_function_calls = 1
  let g:go_highlight_operators     = 1
  let g:go_highlight_extra_types   = 1
  let g:go_highlight_methods       = 1
  let g:go_highlight_generate_tags = 1
endif


"==============================================================================
" NERDTree
"==============================================================================

map <F10> :NERDTreeToggle<CR>
noremap <silent> <C-b>      :NERDTreeToggle<CR>
noremap <silent> <M-b>      :NERDTreeToggle<CR>
noremap <silent> <leader>nf :NERDTreeFind<CR>
noremap <silent> <leader>e  :NERDTreeFind<CR>

let NERDTreeShowLineNumbers = 1
let NERDTreeAutoCenter      = 1
let NERDTreeShowHidden      = 1
let NERDTreeShowBookmarks   = 2
let NERDTreeIgnore          = ['\.pyc', '\~$', '\.swp', '.git']

let g:NERDTreeGitStatusShowIgnored = 1
let g:NERDTreeGitStatusIndicatorMapCustom = {
    \ 'Modified'  : '✹',
    \ 'Staged'    : '✚',
    \ 'Untracked' : '✭',
    \ 'Renamed'   : '➜',
    \ 'Unmerged'  : '═',
    \ 'Deleted'   : '✖',
    \ 'Dirty'     : '✗',
    \ 'Clean'     : '✔︎',
    \ 'Ignored'   : '☒',
    \ 'Unknown'   : '?'
    \ }


"==============================================================================
" fzf
"==============================================================================

" jump to existing window when opening a buffer that is already open
let g:fzf_buffers_jump = 1

nnoremap <leader>fl  :Lines<CR>
nnoremap <leader>fbl :BLines<CR>
nnoremap <leader>ff  :Files<CR>
nnoremap <leader>fr  :Rg<CR>


"==============================================================================
" other mappings and commands
"==============================================================================

" tab page switching
:nn <Leader>1 1gt
:nn <Leader>2 2gt
:nn <Leader>3 3gt
:nn <Leader>4 4gt
:nn <Leader>5 5gt
:nn <Leader>6 6gt
:nn <Leader>7 7gt
:nn <Leader>8 8gt
:nn <Leader>9 9gt
:nn <Leader>0 :tablast<CR>

" show highlight group under cursor in the status line
set laststatus=2
set statusline+=%{synIDattr(synID(line('.'),col('.'),1),'name')}

nmap <Leader>gn :call <SID>SynStack()<CR>
map <F3> :echo "hi<" . synIDattr(synID(line("."),col("."),1),"name") . '> trans<' . synIDattr(synID(line("."),col("."),0),"name") . "> lo<" . synIDattr(synIDtrans(synID(line("."),col("."),1)),"name") . ">" . " FG:" . synIDattr(synIDtrans(synID(line("."),col("."),1)),"fg#")<CR>

function! <SID>SynStack()
    if !exists("*synstack")
        return
    endif
    echo map(synstack(line('.'), col('.')), 'synIDattr(v:val, "name")')
endfunc

" navigate in insert mode with ctrl+hjkl
imap <silent> <C-h> <Left>
imap <silent> <C-l> <Right>
imap <silent> <C-j> <Down>
imap <silent> <C-k> <Up>

" case coercion commands (via vim-abolish)
command! Snake     call feedkeys("crs")
command! Pascal    call feedkeys("crm")
command! Camel     call feedkeys("crc")
command! Upper     call feedkeys("cru")
command! Kebab     call feedkeys("cr-")
command! DotCase   call feedkeys("cr.")
command! SpaceCase call feedkeys("cr<space>")

" command-mode typo abbreviations
cnoreabbrev W!    w!
cnoreabbrev Q!    q!
cnoreabbrev Qall! qall!
cnoreabbrev Wq    wq
cnoreabbrev Wa    wa
cnoreabbrev wQ    wq
cnoreabbrev WQ    wq
cnoreabbrev W     w
cnoreabbrev Q     q
cnoreabbrev Qall  qall
